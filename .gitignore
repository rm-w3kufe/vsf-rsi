__pycache__/
*.pyc
*.egg-info/
dist/
build/
.coverage
.pytest_cache/

# RSI pipeline runtime state — auto-generated, not repo artifacts
# Seeds are committed; learned predicates live in state/predicates/ at runtime
state/predicates/*.json

# Agent-specific state (when VOS_AGENT_STATE_DIR is set)
# These files live outside the repo in ~/.vos/agents/{agent_id}/
# But if someone runs without the env var, ignore local state
state/rsi_metrics_history.json
learning_records/scenarios/*.json

# RSI pipeline runtime outputs — auto-generated on every run, never committed
# Root cause: EVOLUTION_DIR points at docs/, so runs dirty the tree.
# (Debt-clearance 2026-09-22: untracked existing files, policy from here on.)
docs/rsi_evolution_history*.jsonl
docs/rsi_forest*.json
docs/rsi_forests.vsm
docs/rsi_generated_*.vsm
docs/rsi_metrics*.json*
vsf_rsi/generated/
